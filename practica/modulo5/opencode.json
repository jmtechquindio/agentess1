      "description": "Revisa el proyecto y propone planes. No escribe archivos ni ejecuta comandos.",
      "mode": "primary",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "allow"
      }
    },
    "build": {
      "description": "Crea archivos y ejecuta comprobaciones del bot de Telegram.",
      "mode": "primary",
      "temperature": 0.1,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow"
      }
    }
  }
}
